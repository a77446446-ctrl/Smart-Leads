FROM node:22-bookworm-slim
WORKDIR /app
ENV NODE_ENV=production
ENV PORT=3000

# Панель использует pg и собственный HTTP-сервер без сборки клиентского приложения.
COPY operator/package.json operator/package-lock.json ./
RUN npm ci --omit=dev && npm cache clean --force
COPY --chown=node:node operator ./operator
USER node
EXPOSE 3000
HEALTHCHECK --interval=30s --timeout=5s --start-period=20s --retries=3 CMD node -e "fetch('http://127.0.0.1:'+process.env.PORT+'/api/health').then(r=>process.exit(r.ok?0:1)).catch(()=>process.exit(1))"
CMD ["node", "operator/server.mjs"]
