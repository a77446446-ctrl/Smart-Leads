# PostgreSQL в Coolify
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/DATABASE?schema=public"
DIRECT_URL="postgresql://USER:PASSWORD@HOST:5432/DATABASE?schema=public"

# MAX Mini App и Bot API
MAX_BOT_TOKEN=""
# Имя бота клиента без @
MAX_BOT_USERNAME=""
# 5–256 символов A-Z, a-z, 0-9, _ или -; не совпадает с CRON_SECRET
MAX_WEBHOOK_SECRET=""

# Если контейнер не доверяет цепочке platform-api2.max.ru, путь к официальному PEM Минцифры
NODE_EXTRA_CA_CERTS="/app/certs/russian-trusted-ca-bundle.pem"

# MAX ID администраторов через запятую
ADMIN_MAX_IDS=""

# Сессия приложения: случайная строка не короче 32 байт
AUTH_SESSION_SECRET=""

# Этап 3: отдельный постоянный ключ шифрования proxyString, не короче 32 символов
PARSER_PROXY_ENCRYPTION_KEY=""
# Необязательно: отдельный постоянный ключ backup MAX-сессий; без него используется ключ прокси.
# Смена ключа без ротации сделает существующие backup нечитаемыми.
PARSER_SESSION_ENCRYPTION_KEY=""
# Persistent volume Coolify; перед сменой пути перенесите существующие JSON-сессии
PARSER_SESSIONS_DIR="/app/data/sessions"
PARSER_WORKER_TIMEOUT_MS="120000"
PARSER_DEBUG_ARTIFACTS="false"
# Nixpacks создаёт Python virtualenv по этому пути
PARSER_PYTHON_EXECUTABLE="/opt/venv/bin/python"
# QR-код формируется headless-браузером на сервере и выдаётся только администратору
PARSER_AUTH_HEADLESS="true"
# Необязательно: IANA timezone браузера, например Asia/Tbilisi
PARSER_AUTH_TIMEZONE=""

# Этап 4: «Детектив». Поиск отключён, пока значение не станет true.
DISCOVERY_ENABLED="false"
DISCOVERY_INTERVAL_HOURS="6"
DISCOVERY_AUTO_ACTIVATE_SCORE="85"
DISCOVERY_HTTP_TIMEOUT_MS="10000"
# Запросы разделяются символом |; максимум 20 запросов за цикл.
DISCOVERY_QUERIES=""
# Официальный Google Custom Search JSON API
DISCOVERY_GOOGLE_API_KEY=""
DISCOVERY_GOOGLE_CX=""
# Официальный VK API newsfeed.search
DISCOVERY_VK_TOKEN=""
DISCOVERY_VK_API_VERSION="5.199"
# Необязательный ручной импорт MAX-ссылок без внешнего API
DISCOVERY_SEED_URLS=""

# Этап 5: реальные реквизиты владельца сервиса. Без них реальные платежи запрещены.
LEGAL_DOCUMENT_VERSION="2026-08-23"
LEGAL_EFFECTIVE_DATE="23 августа 2026 года"
LEGAL_OPERATOR_NAME=""
LEGAL_TAX_ID=""
LEGAL_REGISTRATION_ID=""
LEGAL_ADDRESS=""
LEGAL_EMAIL=""
LEGAL_SUPPORT_EMAIL=""
# Стартовый бонус в копейках: 30000 = 300 ₽
ONBOARDING_BONUS_KOPECKS="30000"

# Фоновый cron endpoint
CRON_SECRET=""
INGEST_SECRET=""

# Только для локальной разработки: включает маршрут фальшивой admin-сессии.
# В production маршрут всегда недоступен независимо от значения.
DEV_LOGIN_ENABLED="false"
# Числовой тестовый MAX ID; должен одновременно присутствовать в ADMIN_MAX_IDS.
DEV_ADMIN_MAX_ID=""

# AI
DEEPSEEK_API_KEY=""
OPENAI_API_KEY=""

# Публичный HTTPS-домен Mini App без завершающего слеша
NEXT_PUBLIC_APP_URL="https://example.ru"

# Этап 6: ЮKassa
YOOKASSA_SHOP_ID=""
YOOKASSA_SECRET_KEY=""
# Код НДС из настроек магазина ЮKassa; 1 = без НДС
YOOKASSA_VAT_CODE="1"
YOOKASSA_RETURN_URL="https://example.ru/subscriptions"
