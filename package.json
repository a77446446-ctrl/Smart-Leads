{
  "name": "smart-leads",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "setup:local": "node scripts/setup-local-postgres.mjs",
    "db:local:start": "node scripts/start-local-postgres.mjs",
    "db:local:stop": "node scripts/stop-local-postgres.mjs",
    "demo": "npm run db:local:start && next dev --hostname 127.0.0.1 --port 3100",
    "cron": "node scripts/cron.js",
    "start:operator": "node operator/server.mjs",
    "demo:operator": "node scripts/operator-local.mjs",
    "test:operator": "node --test tests/operator.test.mjs",
    "test:operator:postgres": "node --env-file=.env.local --test tests/operator-postgres.test.mjs",
    "start:windows": "start npm run dev && start npm run cron",
    "build": "prisma generate && next build",
    "start": "prisma migrate deploy && npm run leads:backfill && concurrently --kill-others-on-fail \"next start\" \"node scripts/cron.js\" \"node scripts/instance-telemetry.mjs\"",
    "telemetry": "node scripts/instance-telemetry.mjs",
    "leads:backfill": "node --experimental-strip-types scripts/backfill-lead-content.mjs",
    "lint": "node node_modules/eslint/bin/eslint.js src --ext .ts,.tsx --no-cache",
    "typecheck": "tsc --noEmit --incremental false",
    "db:validate": "prisma validate",
    "db:deploy": "prisma migrate deploy",
    "bot:webhook": "node scripts/setup-max-webhook.js",
    "verify": "npm run typecheck && npm run lint && npm run db:validate",
    "test": "node --experimental-strip-types tests/all.test.mjs",
    "test:bonus:postgres": "node --env-file=.env.local --experimental-strip-types --test tests/auth-bonus-postgres.test.mjs",
    "test:proxy:local": "node --env-file=.env.local --experimental-strip-types --test tests/proxy-local.test.mjs",
    "test:branding": "node --experimental-strip-types --test tests/branding.test.mjs",
    "test:demo": "node --experimental-strip-types --test tests/demo.test.mjs",
    "verify:protected": "node scripts/verify-protected.mjs",
    "verify:package": "node scripts/verify-package.mjs"
  },
  "dependencies": {
    "@prisma/adapter-pg": "7.9.1",
    "@prisma/client": "7.9.1",
    "clsx": "2.1.1",
    "concurrently": "10.0.5",
    "framer-motion": "11.18.2",
    "lucide-react": "0.323.0",
    "next": "15.5.24",
    "pg": "8.20.0",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "recharts": "^3.10.1",
    "tailwind-merge": "2.6.1",
    "undici": "7.29.1",
    "zustand": "4.5.7"
  },
  "devDependencies": {
    "@types/node": "20.19.39",
    "@types/pg": "8.20.0",
    "@types/react": "18.3.28",
    "@types/react-dom": "18.3.7",
    "autoprefixer": "10.5.0",
    "eslint": "8.57.1",
    "eslint-config-next": "15.5.24",
    "postcss": "8.5.26",
    "prisma": "7.9.1",
    "tailwindcss": "3.4.19",
    "typescript": "5.9.3"
  },
  "engines": {
    "node": "22.x"
  },
  "overrides": {
    "postcss": "8.5.26",
    "fast-uri": "3.1.6",
    "mysql2": "3.24.0",
    "brace-expansion": "1.1.18",
    "browserslist": "4.28.7",
    "js-yaml": "4.3.1",
    "postcss-selector-parser": "6.1.3"
  }
}
